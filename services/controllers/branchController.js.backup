const Branch = require("../models/Branch");

// Create Branch
exports.createBranch = async (req, res) => {
  try {
    const branch = await Branch.create({
      ...req.body,
      organizationId: req.tenant.organizationId,
    });

    res.json({
      success: true,
      branch,
    });
  } catch (err) {
    res.status(500).json({
      success: false,
      error: err.message,
    });
  }
};

// Get All Branches
exports.getBranches = async (req, res) => {
  try {
    const branches = await Branch.find({
      organizationId: req.tenant.organizationId,
    }).sort({ createdAt: -1 });

    res.json({
      success: true,
      branches,
    });
  } catch (err) {
    res.status(500).json({
      success: false,
      error: err.message,
    });
  }
};
